# Server-side only. Copy this file to backend/.env; never commit that file.
# In Supabase: project siaxqqewpiowfrxfdpkl > Connect > Direct connection.
# Replace YOUR_PERCENT_ENCODED_DATABASE_PASSWORD with the database password.
# This is NOT the Supabase account password, API key, or publishable key.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PERCENT_ENCODED_DATABASE_PASSWORD@db.siaxqqewpiowfrxfdpkl.supabase.co:5432/postgres?sslmode=require
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=[]
EMAIL_PROVIDER=mock
EMAIL_TEST_MODE=true
# Optional: a separate, local database ending in _test. Never use Supabase postgres for tests.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:test_password@localhost:5432/calpulli_test
# Set an independent random token of at least 32 characters to enable protected APIs.
# INTERNAL_API_TOKEN=
