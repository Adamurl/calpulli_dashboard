# Local development only. Never reuse this password in production.
POSTGRES_USER=calpulli
POSTGRES_PASSWORD=calpulli_dev_only
POSTGRES_DB=calpulli
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://calpulli:calpulli_dev_only@localhost:5432/calpulli
APP_ENV=development
LOG_LEVEL=INFO
# Unset DOCS_ENABLED to enable docs only in development.
# DOCS_ENABLED=false
CORS_ORIGINS=[]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=3000
# Optional isolated integration database. Create separately; never target the development database.
# TEST_DATABASE_URL=postgresql+psycopg://calpulli:calpulli_dev_only@localhost:5432/calpulli_test
# Individual user login and worker settings are intentionally absent.

# Optional protected presentation API. Generate independent random secrets locally.
# Unset tokens disable their respective endpoints; never use development placeholder values.
# INTERNAL_API_TOKEN=
# WIX_WEBHOOK_TOKEN=
# WIX_FORM_ID=

# Email defaults are safe: mock provider, test-recipient redirection enabled.
EMAIL_PROVIDER=mock
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=
GMAIL_SENDER_NAME=Calpulli Tonalehqueh
GMAIL_SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
# Optional separate privilege for explicitly preparing send-again drafts.
# EMAIL_SEND_AGAIN_TOKEN=
